# Copy this to .env and fill in your values

# Required — get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your brand info (customize these)
NICHE=local roofing company
BRAND_VOICE=direct, no-BS, results-focused
TARGET_AUDIENCE=homeowners aged 35-60 who need roof repairs or replacements
INSTAGRAM_HANDLE=@yourhandle

# Optional: comma-separated competitor handles to track
COMPETITORS=@competitor1,@competitor2
